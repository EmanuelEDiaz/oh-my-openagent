 import { selectAll } from "../db/query"
+import type { Currency } from "../domain/currency"
 import { formatMoney } from "../domain/money"
 import { ORDER_STATUSES } from "../domain/status"
 
-/** Revenue per status, from the orders table. */
+const CURRENCIES: readonly Currency[] = ["USD", "EUR"]
+
+/** Revenue per status and currency, from the orders table (currencies are never added together). */
 export function nightlyReport(): string {
   const records = selectAll("orders")
   return ORDER_STATUSES.map((status) => {
-    const cents = records.filter((record) => record.status === status).reduce((sum, record) => sum + record.total_cents, 0)
-    return `${status}: ${formatMoney(cents)}`
+    const ofStatus = records.filter((record) => record.status === status)
+    const sums = CURRENCIES.map((currency) => ({ currency, cents: ofStatus.filter((record) => record.currency === currency).reduce((sum, record) => sum + record.total_cents, 0) }))
+    const shown = sums.filter((sum) => sum.cents > 0)
+    return `${status}: ${(shown.length > 0 ? shown : [{ currency: CURRENCIES[0] ?? "USD", cents: 0 }]).map((sum) => formatMoney(sum.cents, sum.currency)).join(" + ")}`
   }).join("\n")
 }
