+import { isOrderStatus } from "../../domain/status"
 import { getOrderSummary, listOrderSummaries } from "../../services/order-service"
 import { json, notFound } from "../json"
 import { ORDER_WIRE, toWire } from "../wire"
 
-export function listOrdersHandler(_url: URL): Response {
-  return json(listOrderSummaries().map((summary) => toWire(summary, ORDER_WIRE)))
+export function listOrdersHandler(url: URL): Response {
+  const status = url.searchParams.get("status")
+  if (status !== null && !isOrderStatus(status)) return json({ error: `unknown status ${status}` }, 400)
+  const summaries = listOrderSummaries().filter((summary) => status === null || summary.status === status)
+  return json(summaries.map((summary) => toWire(summary, ORDER_WIRE)))
 }
 
